alias vim="nvim"

# Git (these override the Oh My Zsh git plugin's versions where names clash)
alias ga='git add'
alias gc="git commit --verbose"
alias gp="git push"
alias gl="git pull"
alias gst="git status"
alias gco="git checkout"
alias grb='git rebase'
alias grs='git restore'
alias gss='git stash'

# Django / Python
alias soa="source .venv/bin/activate"
alias pmr="python manage.py runserver"
alias pmmm="python manage.py makemigrations"
alias pmm="python manage.py migrate"
alias pms="python manage.py shell_plus"

# Npm
alias nrd="npm run dev"
alias nrb="npm run build"

# SSH: the systemd ssh-agent runs per login and ~/.ssh/config adds keys on
# first use. `sa` unlocks the key up front (e.g. before signing commits).
alias sa='ssh-add ~/.ssh/id_ed25519'
alias sr='ssh-add -D'
